# Portul pe care rulează serverul (implicit 3000)
PORT=3000

# Meta Graph API Token (obținut gratuit din https://developers.facebook.com/tools/explorer/)
# Începe cu "EAAB..." sau "EAAC..."
META_ACCESS_TOKEN=

# Țara țintă pentru reclame (RO, US, GB, DE, etc.)
META_TARGET_COUNTRY=RO

# Opțional: Cheie API OpenAI pentru asistentul AI Copilot inteligent (GPT-4o)
OPENAI_API_KEY=

# Opțional: Cheie API Anthropic pentru Claude 3.5 Sonnet
ANTHROPIC_API_KEY=
